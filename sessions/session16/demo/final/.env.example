# Puerto en el que se ejecutará el servidor.
PORT=3000

# Nivel de logging de la aplicación.
# Opciones: debug, info, warn, error.
# Para desarrollo se puede usar "debug". Para producción se recomienda "info" o superior.
LOG_LEVEL=debug

# URL de la aplicación cliente (por ejemplo, el frontend).
# Se utiliza para la configuración de CORS y redirecciones.
CLIENT_URL=http://localhost:5173

# Entorno de ejecución.
# Opciones: development, production, test.
NODE_ENV=development

# Clave secreta utilizada para firmar tokens y otras operaciones criptográficas.
SECRET_KEY=<your-secret-key>
